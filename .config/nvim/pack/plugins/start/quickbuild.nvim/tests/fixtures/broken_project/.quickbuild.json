{
  "patterns": [
    {
      "regex": "^(.+?):(\\d+):(\\d+): (error|warning|note): (.+)$",
      "groups": {"file": 1, "line": 2, "col": 3, "severity": 4, "message": 5}
    },
    {
      "regex": "^(.+?)\\((\\d+),(\\d+)\\): (error|warning) C\\d+: (.+)$",
      "groups": {"file": 1, "line": 2, "col": 3, "severity": 4, "message": 5}
    }
  ],
  "commands": [
    {"name": "Configure", "command": "cmake -B build -S ."},
    {"name": "Build", "command": "cmake --build build --config Release"}
  ],
  "auto_build_on_save": true,
  "file_patterns": ["*.cpp", "*.hpp", "*.c", "*.h"],
  "debounce_ms": 500
}
